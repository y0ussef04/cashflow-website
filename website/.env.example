# Public build configuration only. Never add private keys or service-role credentials.
# Cloudflare automatically supplies CF_PAGES_URL; set this to the stable free pages.dev URL after creation.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
# Production catalog PUBLIC P-256 SPKI key ring only: keyId=base64;keyId2=base64
NEXT_PUBLIC_CATALOG_SIGNING_PUBLIC_KEYS=
# Optional override of the existing official WhatsApp contact.
NEXT_PUBLIC_WHATSAPP_URL=
